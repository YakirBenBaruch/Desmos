@page "/"

<div class="page">

    <div class="app">

        <div class="side-panel">
            <h1>Parabola Drawer</h1>
            <p class="subtitle">y = ax² + bx + c</p>

            <div class="input-box">
                <label>Value of a</label>
                <input type="number" @bind-value="a" />
            </div>

            <div class="input-box">
                <label>Value of b</label>
                <input type="number" @bind-value="b" />
            </div>

            <div class="input-box">
                <label>Value of c</label>
                <input type="number" @bind-value="c" />
            </div>

            <button @onclick="Draw">Draw</button>
            <button class="clear-btn" @onclick="ClearGraph">Clear Graph</button>

            <div class="formula-card">
                <span>Current function:</span>
                <strong>y = @a x² + @b x + @c</strong>
            </div>
        </div>

        <div class="graph-area">

            <div class="top-bar">
                <h2>Graph</h2>
                <span>500 × 500</span>
            </div>

            <div class="svg-box">
                <svg width="@width" height="@height">

                    @((MarkupString)grid)

                    <line x1="0" y1="250" x2="500" y2="250" stroke="#222" stroke-width="2" />
                    <line x1="250" y1="0" x2="250" y2="500" stroke="#222" stroke-width="2" />

                    @((MarkupString)data)

                </svg>
            </div>

        </div>

    </div>

</div>

<style>
    .page {
        min-height: 100vh;
        background-color: #f3f4f7;
        display: flex;
        justify-content: center;
        align-items: center;
        font-family: Arial;
        padding: 30px;
        box-sizing: border-box;
    }

    .app {
        width: 1000px;
        background-color: white;
        border-radius: 18px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.18);
        overflow: hidden;
        display: flex;
        border: 1px solid #ddd;
    }

    .side-panel {
        width: 300px;
        background-color: #ffffff;
        border-right: 1px solid #ddd;
        padding: 25px;
        box-sizing: border-box;
    }

        .side-panel h1 {
            margin: 0;
            color: #1f2937;
            font-size: 26px;
        }

    .subtitle {
        margin-top: 8px;
        color: #6b7280;
        font-size: 17px;
    }

    .input-box {
        margin-top: 22px;
        background-color: #f9fafb;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        padding: 12px;
    }

    label {
        display: block;
        color: #374151;
        font-weight: bold;
        margin-bottom: 8px;
        font-size: 14px;
    }

    input {
        width: 100%;
        padding: 11px;
        border-radius: 10px;
        border: 1px solid #cfd4dc;
        font-size: 17px;
        box-sizing: border-box;
        background-color: white;
    }

        input:focus {
            outline: none;
            border-color: #2d70b3;
            box-shadow: 0 0 0 3px rgba(45, 112, 179, 0.15);
        }

    button {
        width: 100%;
        margin-top: 18px;
        background-color: #2d70b3;
        color: white;
        border: none;
        padding: 13px;
        border-radius: 10px;
        font-size: 18px;
        cursor: pointer;
        font-weight: bold;
    }

        button:hover {
            background-color: #245a91;
        }

    .clear-btn {
        margin-top: 10px;
        background-color: #e63946;
    }

        .clear-btn:hover {
            background-color: #c92f3b;
        }

    .formula-card {
        margin-top: 25px;
        background-color: #f1f5f9;
        border-left: 5px solid #2d70b3;
        padding: 15px;
        border-radius: 10px;
        color: #1f2937;
    }

        .formula-card span {
            display: block;
            font-size: 14px;
            color: #6b7280;
            margin-bottom: 6px;
        }

        .formula-card strong {
            font-size: 18px;
        }

    .graph-area {
        flex: 1;
        background-color: #fafafa;
        padding: 25px;
        box-sizing: border-box;
    }

    .top-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 15px;
    }

        .top-bar h2 {
            margin: 0;
            color: #1f2937;
            font-size: 24px;
        }

        .top-bar span {
            color: #6b7280;
            font-size: 14px;
        }

    .svg-box {
        width: 500px;
        height: 500px;
        background-color: white;
        border: 1px solid #cfd4dc;
        border-radius: 8px;
        overflow: hidden;
        margin: auto;
        box-shadow: inset 0 0 8px rgba(0, 0, 0, 0.08);
    }

    svg {
        display: block;
        background-color: white;
    }
</style>

@code
{
    double a = 1;
    double b = 0;
    double c = 0;

    string data = "";
    string grid = "";

    int width = 500;
    int height = 500;

    void Draw()
    {
        data = "";
        grid = "";

        DrawGrid();

        Parabula p = new Parabula(a, b, c);
        Point[] arr = p.Getpoints();

        for (int i = 0; i < arr.Length; i++)
        {
            data += $@"<circle
                        cx=""{(arr[i].Getx() * 20) + 250}""
                        cy=""{(-arr[i].Gety() * 20) + 250}""
                        r=""1""
                        fill=""#c74440"">
                       </circle>";
        }
    }

    void DrawGrid()
    {
        for (int i = 0; i <= 500; i += 20)
        {
            grid += $@"<line x1=""{i}"" y1=""0"" x2=""{i}"" y2=""500"" stroke=""#e5e7eb"" stroke-width=""1"" />";
            grid += $@"<line x1=""0"" y1=""{i}"" x2=""500"" y2=""{i}"" stroke=""#e5e7eb"" stroke-width=""1"" />";
        }

        for (int i = 0; i <= 500; i += 100)
        {
            grid += $@"<line x1=""{i}"" y1=""0"" x2=""{i}"" y2=""500"" stroke=""#d1d5db"" stroke-width=""1.5"" />";
            grid += $@"<line x1=""0"" y1=""{i}"" x2=""500"" y2=""{i}"" stroke=""#d1d5db"" stroke-width=""1.5"" />";
        }
    }

    void ClearGraph()
    {
        data = "";
        grid = "";
    }
}